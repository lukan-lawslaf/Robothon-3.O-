# Copy to .env. These variables are read by the backend only.
DATA_BACKEND=supabase
PORT=8787
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SERVER_SECRET_KEY
# Legacy SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY also work.
# For an explicit local preview without Supabase, use DATA_BACKEND=local.
# Never put a Supabase secret/service-role key in VITE_* variables or frontend code.
